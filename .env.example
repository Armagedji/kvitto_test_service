# --- для локального запуска без Docker (uvicorn + docker run postgres) ---
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
ALEMBIC_DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5432/payments
WEBHOOK_SECRET=dev-secret

# --- для docker compose ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments